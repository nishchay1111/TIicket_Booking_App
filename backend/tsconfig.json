{
  "compilerOptions": {
    /* ========================
       BASIC SETTINGS
    ======================== */
    "target": "ES2020",
    "module": "Node16",

    /* ========================
       PROJECT STRUCTURE
    ======================== */
    "rootDir": "./",
    "outDir": "./dist",

    /* ========================
       TYPE SAFETY
    ======================== */
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* ========================
       NODE COMPATIBILITY (UPDATED ✅)
    ======================== */
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "types": ["node"],

    /* ========================
       PERFORMANCE
    ======================== */
    "skipLibCheck": true,

    /* ========================
       DEBUGGING
    ======================== */
    "sourceMap": true
  },

  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}